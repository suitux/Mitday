# Database (Neon in production; local docker Postgres in dev: `pnpm db:up`)
DATABASE_URL=postgres://postgres:postgres@localhost:54329/quadra

# Auth.js
AUTH_SECRET=            # `openssl rand -base64 32`
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend (magic link + transactional emails). Without a key, emails are logged to the console.
# RESEND_API_KEY (Vercel Marketplace integration) also works.
AUTH_RESEND_KEY=
EMAIL_FROM="Mitday <no-reply@example.com>"

# Public base URL used in emails and share links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Upstash rate limiting (Vercel Marketplace: KV_REST_API_URL/KV_REST_API_TOKEN also accepted).
# Disabled when unset — required in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Test-only login provider for Playwright. NEVER set in production (ignored there anyway).
AUTH_TEST_LOGIN=
